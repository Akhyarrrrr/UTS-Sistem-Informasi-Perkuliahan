{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "installCommand": "npm ci",
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "regions": ["bom1"],
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0",
            "maxDuration": 60
        }
    },
    "routes": [
        { "src": "/(?:.*\/)?\\.[^/]*(?:/.*)?", "dest": "/api/index.php", "status": 404 },
        { "src": "/.*\\.[pP][hH][pP](?:/.*)?", "dest": "/api/index.php", "status": 404 },
        { "src": "/", "dest": "/api/index.php" },
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ]
}
